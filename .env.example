# Single template for all environments.
# Copy this file to:
# - .env.development
# - .env.staging
# - .env.production

# Public frontend URL of your waitlist API (Cloudflare Worker base URL, no trailing slash)
# Example (dev): http://127.0.0.1:8787
# Example (prod): https://pictobook-functions.<account>.workers.dev
VITE_WAITLIST_API_URL=

# Cloudflare Turnstile site key (public; used in browser widget)
# Get from: Cloudflare Dashboard -> Turnstile -> Your widget -> Site Key
VITE_TURNSTILE_SITE_KEY=

# Supabase project REST URL (NOT the Postgres DATABASE_URL)
# Example: https://<project-ref>.supabase.co
SUPABASE_URL=

# Supabase service role key (secret; worker/server only)
# Get from: Supabase Dashboard -> Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile secret key (secret; worker/server only)
# Get from: Cloudflare Dashboard -> Turnstile -> Your widget -> Secret Key
TURNSTILE_SECRET=

# Exact browser origin allowed by worker CORS
# Example (dev): http://localhost:3000
# Example (prod): https://pictobook.com
ALLOWED_ORIGIN=http://localhost:3000

# Secret salt used to hash IP values before storing
# Use a long random string and keep it stable per environment
IP_HASH_SALT=

# Postgres connection string used by dbmate migrations
# This is for direct DB access (not SUPABASE_URL)
# Example: postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL=
