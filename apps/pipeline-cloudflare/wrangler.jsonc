{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pictobook-pipeline-spike-dev",
  "main": "src/index.ts",
  "workers_dev": false,
  "compatibility_date": "2026-11-07",
  "vars": {
    "PIPELINE_INITIAL_CANDIDATE_COUNT": "2",
    "LOCAL_CUSTOMER_API": "true",
    "IMAGE_PROVIDER": "mock",
  },
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  "d1_databases": [
    {
      "binding": "PIPELINE_DB",
      "database_name": "pictobook-pipeline-spike-dev",
      "database_id": "7bbba9dc-277f-4536-b057-c6dc58fc010d",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PIPELINE_ARTIFACTS",
      "bucket_name": "pictobook-pipeline-spike-dev",
    },
  ],
  "workflows": [
    {
      "name": "pictobook-pipeline-spike-dev",
      "binding": "BOOK_RUN_WORKFLOW",
      "class_name": "BookRunWorkflow",
    },
    {
      "name": "pictobook-production-book-run-dev",
      "binding": "PRODUCTION_BOOK_RUN_WORKFLOW",
      "class_name": "ProductionBookRunWorkflow",
    },
  ],
  "containers": [
    {
      "class_name": "ImageContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "../pipeline-image-worker/Dockerfile",
          "build_context": "../..",
        },
      },
      "observability": {
        "logs": {
          "enabled": true,
        },
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "IMAGE_CONTAINER",
        "class_name": "ImageContainer",
      },
    ],
  },
  "exports": {
    "ImageContainer": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "env": {
    "preview": {
      "workers_dev": true,
      "vars": {
        "LOCAL_CUSTOMER_API": "false",
        "R2_ENDPOINT": "https://80cab986d9f7c33ae20f05b088aa2604.r2.cloudflarestorage.com",
        "R2_BUCKET": "pictobook-pipeline-preview",
        "IMAGE_PROVIDER": "gemini",
        "GEMINI_IMAGE_MODEL": "gemini-nano-banana-2.1",
        "GEMINI_CANDIDATE_COST_MICROS": "65000",
        "GEMINI_VISION_MODEL": "gemini-3.8-flash",
        "GEMINI_STYLE_JUDGE_COST_MICROS": "10000",
        "PIPELINE_INITIAL_CANDIDATE_COUNT": "2",
        "SMOKE_TESTS_ENABLED": "true",
      },
      "d1_databases": [
        {
          "binding": "PIPELINE_DB",
          "database_name": "pictobook-pipeline-preview",
          "database_id": "34d7b3b0-1006-467a-8830-c8c584da687c",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "PIPELINE_ARTIFACTS",
          "bucket_name": "pictobook-pipeline-preview",
        },
      ],
      "workflows": [
        {
          "name": "pictobook-pipeline-preview",
          "binding": "BOOK_RUN_WORKFLOW",
          "class_name": "BookRunWorkflow",
        },
        {
          "name": "pictobook-production-book-run-preview",
          "binding": "PRODUCTION_BOOK_RUN_WORKFLOW",
          "class_name": "ProductionBookRunWorkflow",
        },
      ],
      "containers": [
        {
          "class_name": "ImageContainer",
          "scheduling_policy": "durable_object",
          "images": {
            "base": {
              "dockerfile": "../pipeline-image-worker/Dockerfile",
              "build_context": "../..",
            },
          },
          "observability": {
            "logs": {
              "enabled": true,
            },
          },
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "IMAGE_CONTAINER",
            "class_name": "ImageContainer",
          },
        ],
      },
    },
  },
}
