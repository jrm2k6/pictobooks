# Copy to .env.preview. This file is loaded by `pnpm smoke:preview`.
PICTOBOOK_PREVIEW_URL=https://pictobook-pipeline-spike-dev-preview.<workers-subdomain>.workers.dev
PICTOBOOK_PREVIEW_SMOKE_TOKEN=<same-value-as-the-SMOKE_TEST_TOKEN-worker-secret>

# Optional when the preview hostname is protected by Cloudflare Access.
# PICTOBOOK_PREVIEW_ACCESS_CLIENT_ID=
# PICTOBOOK_PREVIEW_ACCESS_CLIENT_SECRET=
