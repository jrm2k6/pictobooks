# Copy to .env.production. Production also requires the CLI confirmation flag.
PICTOBOOK_PRODUCTION_URL=https://<production-host>
PICTOBOOK_PRODUCTION_SMOKE_TOKEN=<same-value-as-the-production-worker-secret>

# Optional when the production hostname is protected by Cloudflare Access.
# PICTOBOOK_PRODUCTION_ACCESS_CLIENT_ID=
# PICTOBOOK_PRODUCTION_ACCESS_CLIENT_SECRET=
