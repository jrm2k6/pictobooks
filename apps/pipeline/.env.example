# Pictobook pipeline local provider configuration.
# Copy to apps/pipeline/.env.development and fill only the provider you are testing.

# Defaults to mock when omitted.
# Supported values: mock, openai, gemini, bfl, recraft, stability, adobe_firefly
PICTOBOOK_PIPELINE_PROVIDER=mock

# OpenAI provider placeholder.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
OPENAI_IMAGE_MODEL=

# Google Gemini image provider placeholder.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# Optional override for compatible API gateways. Defaults to Google's v1 API.
GEMINI_API_BASE_URL=

# Black Forest Labs provider placeholder.
BFL_API_KEY=
BFL_IMAGE_MODEL=

# Recraft provider placeholder.
RECRAFT_API_KEY=
RECRAFT_IMAGE_MODEL=
RECRAFT_STYLE_ID=

# Stability provider placeholder.
STABILITY_API_KEY=
STABILITY_IMAGE_MODEL=

# Adobe Firefly provider placeholder.
ADOBE_FIREFLY_CLIENT_ID=
ADOBE_FIREFLY_CLIENT_SECRET=
ADOBE_FIREFLY_IMAGE_MODEL=

# Local reviewer dashboard. Prefer dashboard:cloudflare:preview to load the
# ignored apps/pipeline-cloudflare/.env.preview file automatically.
PICTOBOOK_API_BASE_URL=
PICTOBOOK_API_TOKEN=
PICTOBOOK_API_ACCESS_CLIENT_ID=
PICTOBOOK_API_ACCESS_CLIENT_SECRET=
PICTOBOOK_DASHBOARD_PORT=4180
