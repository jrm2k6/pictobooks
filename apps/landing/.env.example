# Vite env file for apps/landing.
# Copy to apps/landing/.env.development (or .env.production) depending on mode.

# Public frontend URL of the waitlist API (Cloudflare Worker base URL, no trailing slash)
# Example (local worker): http://127.0.0.1:8787
# Example (deployed worker): https://pictobook-functions.<account>.workers.dev
VITE_WAITLIST_API_URL=

# Cloudflare Turnstile site key (public key used by browser widget)
# Get from: Cloudflare Dashboard -> Turnstile -> Your widget -> Site Key
VITE_TURNSTILE_SITE_KEY=
