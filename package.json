{
  "name": "pictobook",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "db:new": "dbmate --migrations-dir db/migrations new",
    "db:up": "dbmate --migrations-dir db/migrations up",
    "db:down": "dbmate --migrations-dir db/migrations down",
    "db:status": "dbmate --migrations-dir db/migrations status",
    "db:up:dev": "dbmate --env-file .env.development --migrations-dir db/migrations up",
    "db:down:dev": "dbmate --env-file .env.development --migrations-dir db/migrations down",
    "db:status:dev": "dbmate --env-file .env.development --migrations-dir db/migrations status",
    "db:up:staging": "dbmate --env-file .env.staging --migrations-dir db/migrations up",
    "db:down:staging": "dbmate --env-file .env.staging --migrations-dir db/migrations down",
    "db:status:staging": "dbmate --env-file .env.staging --migrations-dir db/migrations status",
    "db:up:prod": "dbmate --env-file .env.production --migrations-dir db/migrations up",
    "db:down:prod": "dbmate --env-file .env.production --migrations-dir db/migrations down",
    "db:status:prod": "dbmate --env-file .env.production --migrations-dir db/migrations status"
  },
  "devDependencies": {
    "dbmate": "^2.28.0",
    "prettier": "^3.6.2",
    "typescript": "5.6.3"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "pnpm": {
    "patchedDependencies": {
      "wouter@3.7.1": "patches/wouter@3.7.1.patch"
    },
    "overrides": {
      "tailwindcss>nanoid": "3.3.7"
    }
  }
}
